{% extends 'base.html.twig' %}

{% block title %}BaseItem{% endblock %}

{% block body %}
    <h1>BaseItem</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ base_item.id }}</td>
            </tr>
            <tr>
                <th>PublicStatus</th>
                <td>{{ base_item.publicStatus }}</td>
            </tr>
            <tr>
                <th>Subject</th>
                <td>{{ base_item.subject }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ base_item.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_base_item_index') }}">back to list</a>

    <a href="{{ path('app_base_item_edit', {'id': base_item.id}) }}">edit</a>

    {{ include('base_item/_delete_form.html.twig') }}
{% endblock %}
