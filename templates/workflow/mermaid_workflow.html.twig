<div class="mermaid">
  graph TD
  {% for transition in workflowTransitions %}
    {{ transition.fromState.getName() | replace({' ': '_'}) }}["{{ transition.fromState.getName() }}"]
    -->|{{ transition.getType() }}|
    {{ transition.toState.getName() | replace({' ': '_'}) }}["{{ transition.toState.getName() }}"]
  {% endfor %}
</div>

<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
<script>
  mermaid.initialize({ startOnLoad: true });
</script>
